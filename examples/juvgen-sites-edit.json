 "_": "기준 편집 계획 (2026-11-27 쥬브젠 시술부위). 새 편을 짤 때 옆에 두고 본다. 자료 그림은 시험용 이름이다.",
 "lines": [
  {"a": 69.43, "b": 70.45, "who": "pd", "text": "원장님", "id": "0"},
  {"a": 71.21, "b": 74.67, "who": "pd", "text": "8개월 전에 올린 '쥬브젠 이 부위엔 안 합니다'", "hl": ["쥬브젠 이 부위엔 안 합니다"], "id": "1"},
  {"a": 74.67, "b": 76.57, "who": "pd", "text": "영상 반응이 좋았는데요", "id": "2"},
  {"a": 77.01, "b": 79.61, "who": "pd", "text": "댓글 보니까 '그럼 이 부위는요?'", "hl": ["그럼 이 부위는요?"], "card": ["c1", "c3"], "id": "3"},
  {"a": 79.74, "b": 82.35, "who": "pd", "text": "라는 다른 부위 질문이 많았어요", "card": ["c1", "c3"], "id": "4"},
  {"a": 82.75, "b": 84.62, "who": "pd", "text": "오늘은 댓글에 남은 질문을", "id": "5"},
  {"a": 86.0, "b": 88.25, "who": "pd", "text": "각 부위별 시술 가능여부와", "hl": ["각 부위별 시술 가능여부"], "title": "합니다 vs 안 합니다", "id": "6"},
  {"a": 88.25, "b": 89.71, "who": "pd", "text": "그 이유를 설명해주세요", "hl": ["그 이유"], "title": "합니다 vs 안 합니다", "id": "7"},
  {"a": 90.49, "b": 95.54, "who": "pd", "text": "먼저 눈 밑에서 볼 쪽으로 꺼져 보이는", "chapter": {"n": 1, "title": "인디언주름"}, "card": "c1", "id": "8"},
  {"a": 95.75, "b": 98.05, "who": "pd", "text": "인디언 밴드에도 쥬브젠을 하나요?", "hl": ["인디언 밴드"], "broll": "face", "card": "c1", "id": "9"},
  {"a": 98.05, "b": 99.3, "who": "dr", "text": "그거는 안 합니다", "broll": "face", "id": "10"},
  {"a": 100.35, "b": 102.98, "who": "dr", "text": "인디언 주름이 생긴 원인이", "broll": "face_dots", "id": "11"},
  {"a": 103.5, "b": 105.83, "who": "dr", "text": "노화에 의한 거긴 하지만", "id": "12"},
  {"a": 105.83, "b": 107.805, "who": "dr", "text": "안에 해부학적인 구조가", "broll": "anatomy", "id": "13"},
  {"a": 107.84, "b": 110.36, "who": "dr", "text": "이미 뼈에 걸려져 있는 거기 때문에", "broll": "anatomy", "id": "14"},
  {"a": 110.36, "b": 111.94, "who": "dr", "text": "그걸 풀어내지 않으면", "em": true, "id": "15"},
  {"a": 112.25, "b": 113.325, "who": "dr", "text": "효과가 없어요", "em": true, "id": "16"},
  {"a": 113.35, "b": 116.35, "who": "dr", "text": "물론 아주 약한 인디언 주름은 효과가 있지만", "id": "17"},
  {"a": 119.08, "b": 121.685, "who": "dr", "text": "원인을 해결하는 게 아니기 때문에", "id": "18"},
  {"a": 121.72, "b": 122.92, "who": "dr", "text": "그건 저는 안 합니다", "em": true, "id": "19"},
  {"a": 124.45, "b": 126.83, "who": "pd", "text": "그러면 코에 난 모공들도", "hl": ["코에 난 모공"], "chapter": {"n": 2, "title": "코 모공"}, "broll": "nose", "card": "c2", "id": "20"},
  {"a": 126.96, "b": 128.75, "who": "pd", "text": "쥬브젠으로 치료가 가능한가요?", "broll": "nose", "card": "c2", "id": "21"},
  {"a": 128.75, "b": 129.68, "who": "dr", "text": "가능합니다", "broll": "nose", "id": "22"},
  {"a": 131.14, "b": 133.0, "who": "pd", "text": "그럼 콧볼 주변의 넓은 모공이나", "hl": ["넓은 모공"], "broll": "nose", "id": "23"},
  {"a": 133.0, "b": 134.77, "who": "pd", "text": "패인 자국에도", "hl": ["패인 자국"], "broll": "nose", "id": "23b"},
  {"a": 134.77, "b": 135.6, "who": "pd", "text": "쥬브젠을 하나요?", "broll": "nose", "id": "24"},
  {"a": 135.6, "b": 136.47, "who": "dr", "text": "네 합니다", "broll": "nose", "id": "25"},
  {"a": 138.48, "b": 141.04, "who": "pd", "text": "좀 효과적으로 볼 수 있는 건가요?", "broll": "nose", "id": "26"},
  {"a": 141.08, "b": 142.12, "who": "dr", "text": "효과는 있어요", "id": "27"},
  {"a": 142.15, "b": 143.79, "who": "dr", "text": "그런데 문제는 뭐냐", "id": "28"},
  {"a": 145.74, "b": 147.02, "who": "dr", "text": "본인이 확인해야 돼요", "id": "29"},
  {"a": 147.31, "b": 149.34, "who": "dr", "text": "의사는 효과 있다고 합니다", "id": "30"},
  {"a": 149.62, "b": 152.42, "who": "dr", "text": "의학적으로도 그렇고 사진을 찍으면", "id": "31"},
  {"a": 152.42, "b": 154.06, "who": "dr", "text": "수술 전후 사진 비교하면", "id": "32"},
  {"a": 154.31, "b": 155.55, "who": "dr", "text": "틀림없이 좋아져요", "em": true, "id": "33"},
  {"a": 155.71, "b": 157.75, "who": "dr", "text": "근데 본인이 그걸 만족할 거냐", "id": "34"},
  {"a": 157.9, "b": 159.21, "who": "dr", "text": "그걸 확인하셔야 됩니다", "id": "35"},
  {"a": 221.09, "b": 223.82, "who": "pd", "text": "가로로 깊게 생긴 목주름에도 쥬브젠을 할 수 있나요?", "hl": ["목주름"], "chapter": {"n": 3, "title": "목주름"}, "card": "c4", "id": "36"},
  {"a": 223.82, "b": 226.61, "who": "dr", "text": "효과 있습니다. 합니다. 할 수 있습니다", "id": "37"},
  {"a": 227.5, "b": 229.14, "who": "dr", "text": "그런데 저는 안 합니다", "em": true, "id": "38"},
  {"a": 229.71, "b": 231.51, "who": "dr", "text": "물론 원하면 해줍니다", "id": "39"},
  {"a": 231.98, "b": 233.92, "who": "dr", "text": "그러나 정확히 알아야 돼요", "id": "40"},
  {"a": 234.17, "b": 236.76, "who": "dr", "text": "목주름은 효과가 틀림없이 있어요", "id": "41"},
  {"a": 237.03, "b": 237.75, "who": "dr", "text": "그러나", "id": "42"},
  {"a": 237.86, "b": 240.03, "who": "dr", "text": "주름이 없었던 것 같이 절대 안 됩니다", "em": true, "id": "43"},
  {"a": 241.72, "b": 244.84, "who": "dr", "text": "무표정 상태에서 정면을 바라보고 있을 때만", "id": "44"},
  {"a": 245.02, "b": 246.17, "who": "dr", "text": "효과가 있는 거예요", "id": "45"},
  {"a": 246.36, "b": 247.82, "who": "dr", "text": "고개를 젖히면", "id": "46"},
  {"a": 248.06, "b": 249.06, "who": "dr", "text": "튀어나옵니다", "id": "47"},
  {"a": 249.73, "b": 253.01, "who": "dr", "text": "고개를 숙이면 앞뒤로 주름이 생겨요", "id": "48"},
  {"a": 253.17, "b": 255.91, "who": "dr", "text": "그 얘기를 다 설명을 하면", "id": "49"},
  {"a": 256.19, "b": 259.14, "who": "dr", "text": "수술할 사람이 거의 없어요", "id": "50"},
  {"a": 259.36, "b": 261.13, "who": "dr", "text": "나는 그래서 목주름은", "id": "51"},
  {"a": 261.24, "b": 263.01, "who": "dr", "text": "지금까지 3명 했습니다", "em": true, "id": "52"},
  {"a": 263.01, "b": 264.71, "who": "dr", "text": "할 수 있어요. 원하면 합니다", "id": "53"},
  {"a": 392.63, "b": 394.97, "who": "pd", "text": "혹시 웃을 때 생기는 눈꼬리", "hl": ["눈꼬리"], "chapter": {"n": 4, "title": "눈꼬리 주름"}, "card": "c3", "id": "54"},
  {"a": 394.97, "b": 396.52, "who": "pd", "text": "주름도 쥬브젠을 하나요?", "card": "c3", "id": "55"},
  {"a": 396.79, "b": 398.23, "who": "dr", "text": "쥬브젠을 하지만", "id": "56"},
  {"a": 400.13, "b": 401.38, "who": "dr", "text": "본인이 판단해야 돼요", "em": true, "id": "57"},
  {"a": 401.68, "b": 404.01, "who": "pd", "text": "그러면 여드름 흉터 같은 경우에는", "hl": ["여드름 흉터"], "chapter": {"n": 5, "title": "여드름흉터"}, "id": "58"},
  {"a": 404.01, "b": 406.71, "who": "pd", "text": "종류 상관없이 쥬브젠으로 치료할 수 있나요?", "id": "59"},
  {"a": 407.24, "b": 409.77, "who": "dr", "text": "튀어나온 흉터는 쥬브젠으로 안 되지만", "id": "60"},
  {"a": 410.02, "b": 412.99, "who": "dr", "text": "모공에서부터 어떤 여드름 흉터도", "id": "61"},
  {"a": 413.19, "b": 415.91, "who": "dr", "text": "튀어나온 걸 제외하고 효과 없는 건 없습니다", "id": "62"},
  {"a": 416.17, "b": 418.2, "who": "dr", "text": "중요한 건 본인이 그 효과를", "id": "63"},
  {"a": 418.2, "b": 420.41, "who": "dr", "text": "만족할 수 있을 거냐는 걸", "id": "64"},
  {"a": 420.55, "b": 423.09, "who": "dr", "text": "정확히 이해를 하고 확인해야 돼요", "em": true, "id": "65"},
  {"a": 305.65, "b": 310.41, "who": "dr", "text": "쥬브젠이라는 거는 깊은 주름이든", "chapter": false, "id": "66"},
  {"a": 310.41, "b": 313.31, "who": "dr", "text": "조금 덜 깊은 주름이든 얕은 주름이든", "id": "67"},
  {"a": 313.31, "b": 315.41, "who": "dr", "text": "심지어 주름을 예방하는 데도 확실히", "id": "68"},
  {"a": 315.41, "b": 316.49, "who": "dr", "text": "효과가 있어요", "id": "69"},
  {"a": 349.78, "b": 352.47, "who": "pd", "text": "마지막으로 환자가 '이 부위도", "id": "70"},
  {"a": 352.47, "b": 354.79, "who": "pd", "text": "쥬브젠이 되겠다'라고 스스로", "id": "71"},
  {"a": 355.08, "b": 357.36, "who": "pd", "text": "판단하는 경우가 있잖아요", "id": "72"},
  {"a": 357.44, "b": 359.1, "who": "dr", "text": "대개는 그렇죠", "id": "73"},
  {"a": 359.26, "b": 362.15, "who": "pd", "text": "그런데 혼자 이렇게 판단하면 안 되는", "id": "74"},
  {"a": 362.15, "b": 363.0, "who": "pd", "text": "이유가 있을까요?", "hl": ["이유"], "id": "75"},
  {"a": 363.65, "b": 366.7, "who": "dr", "text": "본인이 쥬브젠이라는 걸 정확히 이해를 하고", "id": "76"},
  {"a": 366.86, "b": 369.8, "who": "dr", "text": "수술 전후의 과정도 결과도", "id": "77"},
  {"a": 369.82, "b": 372.69, "who": "dr", "text": "자기가 충분히 이해를 했다면 상관없는데", "id": "78"},
  {"a": 372.89, "b": 374.355, "who": "dr", "text": "그런 걸 모르고", "id": "79"},
  {"a": 374.37, "b": 377.58, "who": "dr", "text": "자기 상상과 기대만 갖고 얘기를 하면", "id": "80"},
  {"a": 377.9, "b": 380.96, "who": "dr", "text": "그거는 수술을 하면 안 돼요", "em": true, "id": "81"}
 ]
